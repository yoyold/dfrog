# Default: let git auto-detect, normalize to LF in repo, native on checkout.
* text=auto eol=lf

# Files that MUST stay LF (consumed by Linux tooling / containers).
*.sh        text eol=lf
*.bash      text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# Binaries — never normalize.
*.png       binary
*.jpg       binary
*.gz        binary
*.zip       binary
*.so        binary
*.a         binary
