#pragma once

// Single source of truth: the top-level VERSION file, threaded through CMake.
#define DFROG_VERSION_STRING "@DFROG_VERSION@"

namespace dfrog {

inline constexpr const char* kVersion = DFROG_VERSION_STRING;
inline constexpr int kVersionMajor    = @PROJECT_VERSION_MAJOR@;
inline constexpr int kVersionMinor    = @PROJECT_VERSION_MINOR@;
inline constexpr int kVersionPatch    = @PROJECT_VERSION_PATCH@;

}  // namespace dfrog
